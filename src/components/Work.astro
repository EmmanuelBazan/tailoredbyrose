---
import { getCollection } from 'astro:content';
import WorkItem from './WorkItem.astro';
import { site } from '../data/site';

const works = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<section id="work" class="work">
	<div class="work-header">
		<h2>{site.work.eyebrow}</h2>
		<span class="eyebrow">{site.work.meta}</span>
	</div>

	{works.map((work, i) => <WorkItem work={work} index={i + 1} />)}

	<p class="footnote">{site.work.footnote}</p>
</section>

<style>
	.work {
		padding: clamp(52px, 8vw, 88px) clamp(20px, 5vw, 40px) 0;
	}

	.work-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 8px 20px;
		border-bottom: 1px solid var(--ink);
		padding-bottom: 14px;
	}

	.work-header h2 {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 400;
		font-size: clamp(32px, 4.5vw, 60px);
		letter-spacing: -0.01em;
	}

	.footnote {
		margin: 0;
		padding: clamp(32px, 5vw, 48px) 0 clamp(8px, 2vw, 16px);
		text-align: center;
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
	}
</style>
