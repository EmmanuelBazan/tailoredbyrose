---
import { Image } from 'astro:assets';
import portrait from '../assets/site/about-portrait.jpg';
import { site } from '../data/site';
---

<section id="about" class="about">
	<div class="grid">
		<div>
			<span class="eyebrow dark">{site.about.eyebrow}</span>
			<div class="portrait">
				<Image src={portrait} alt={site.about.portraitAlt} widths={[400, 600, 900]} sizes="(min-width: 701px) 50vw, 100vw" />
			</div>
		</div>
		<div class="copy">
			<p class="paragraph">{site.about.paragraph}</p>
			<div class="stats">
				{
					site.about.stats.map((s) => (
						<div>
							<div class="stat-value">{s.value}</div>
							{s.label}
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>

<style>
	.about {
		background: var(--dark-bg);
		color: var(--dark-ink);
		padding: clamp(52px, 8vw, 88px) clamp(20px, 5vw, 40px);
	}

	.eyebrow.dark {
		color: var(--dark-muted);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
		gap: clamp(28px, 4vw, 56px);
	}

	.portrait {
		margin-top: 24px;
		aspect-ratio: 1 / 1;
		border: 1px solid var(--dark-line);
		overflow: hidden;
	}

	.portrait :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 22%;
		display: block;
	}

	.copy {
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.paragraph {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(22px, 2.4vw, 34px);
		line-height: 1.34;
		text-wrap: pretty;
	}

	.stats {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(110px, 100%), 1fr));
		gap: 20px;
		margin-top: clamp(28px, 4vw, 44px);
		border-top: 1px solid var(--dark-line);
		padding-top: 20px;
		font-family: var(--font-mono);
		font-size: 12px;
		letter-spacing: 0.06em;
		color: var(--dark-muted);
	}

	.stat-value {
		font-family: var(--font-display);
		font-size: 34px;
		color: var(--dark-ink);
	}
</style>
