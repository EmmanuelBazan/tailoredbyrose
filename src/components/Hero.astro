---
import { Image } from 'astro:assets';
import heroImage from '../assets/site/hero.png';
import { site } from '../data/site';
---

<section id="top" class="hero">
	<div class="meta-row">
		<span class="dot"></span>
		<span>Tailoring atelier — {site.location}</span>
		<span class="rule"></span>
		<span>{site.established}</span>
	</div>

	<h1 class="name">Rose<br />Meza</h1>

	<div class="intro">
		<p class="tagline">{site.tagline}</p>
		<div class="credits">
			{site.hero.credits.map((c) => <span>{c}</span>)}
		</div>
	</div>

	<div class="frame">
		<Image src={heroImage} alt={site.hero.imageAlt} widths={[480, 768, 1200, 1600]} sizes="100vw" />
	</div>
</section>

<style>
	.hero {
		padding: clamp(48px, 9vw, 96px) clamp(20px, 5vw, 40px) 0;
	}

	.meta-row {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 10px 16px;
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--accent);
		display: inline-block;
	}

	.rule {
		flex: 1;
		height: 1px;
		background: var(--line);
	}

	.name {
		margin: 28px 0 0;
		font-family: var(--font-display);
		font-weight: 400;
		font-size: clamp(56px, 11vw, 168px);
		line-height: 0.88;
		letter-spacing: -0.02em;
	}

	.intro {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
		gap: clamp(28px, 4vw, 56px);
		align-items: end;
		margin-top: 40px;
		padding-bottom: 48px;
	}

	.tagline {
		margin: 0;
		font-size: clamp(17px, 2vw, 21px);
		line-height: 1.5;
		max-width: 46ch;
		text-wrap: pretty;
	}

	.credits {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		grid-auto-flow: column;
		grid-template-rows: repeat(3, auto);
		gap: 10px 28px;
		font-family: var(--font-mono);
		font-size: 12px;
		letter-spacing: 0.06em;
		white-space: pre;
		color: var(--muted);
		border-top: 1px solid var(--ink);
		padding-top: 14px;
	}

	.frame {
		position: relative;
		border: 1px solid var(--ink);
		overflow: hidden;
	}

	.frame :global(img) {
		width: 100%;
		height: auto;
		display: block;
	}
</style>
