---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

const updated = 'August 23, 2026';
---

<Layout
	title="Privacy Policy — Tailoredbyrose"
	description="How Tailoredbyrose handles the information you share through this website."
>
	<div class="page">
		<Header />

		<main class="doc">
			<p class="eyebrow">Legal</p>
			<h1>Privacy Policy</h1>
			<p class="updated">Last updated: {updated}</p>

			<p class="lede">
				This site is the portfolio of {site.fullName}, an independent tailor based in {site.location}.
				It collects as little information as possible: nothing at all unless you choose to write to
				me through the contact form.
			</p>

			<h2>What this site collects</h2>
			<p>
				<strong>Nothing is collected from simply browsing.</strong> This site sets no cookies, runs no
				analytics, and does not track visitors or build profiles of them.
			</p>
			<p>
				If you fill in the contact form, you send me the information you type into it: your
				<strong>name</strong>, your <strong>email address</strong>, the <strong>type of project</strong>
				you select, an optional <strong>preferred date</strong>, and your <strong>message</strong>.
			</p>

			<h2>Why I collect it and how it is used</h2>
			<p>
				Only to read your enquiry and reply to it. Your details are not sold, rented, or shared for
				advertising, and you will not be added to a mailing list.
			</p>

			<h2>Services this site relies on</h2>
			<p>Three third parties are involved in running this site:</p>
			<ul>
				<li>
					<strong>Web3Forms</strong> — delivers contact form submissions to my email inbox. Your
					message passes through their service on its way to me.
				</li>
				<li>
					<strong>Cloudflare</strong> — hosts and serves this site. Like any web host, its servers
					process technical information such as IP addresses in order to deliver pages and protect
					against abuse.
				</li>
				<li>
					<strong>Google Fonts</strong> — the typefaces used on this site are loaded from Google's
					servers, which means your IP address is visible to Google when the fonts load. No cookies
					are set by this.
				</li>
			</ul>
			<p>
				The Instagram link in the contact section is an ordinary link, not an embedded feed — nothing
				is shared with Instagram unless you click it.
			</p>

			<h2>How long it is kept</h2>
			<p>
				Messages you send stay in my email inbox so I have a record of our conversation. If you would
				rather I delete yours, just ask and I will.
			</p>

			<h2>Your choices</h2>
			<p>
				You can ask me what information of yours I hold, ask me to correct it, or ask me to delete it.
				Write to <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a> and I will take care
				of it.
			</p>
			<p>
				You are never required to use the form — you are welcome to email me directly instead.
			</p>

			<h2>Changes to this policy</h2>
			<p>
				If how this site handles information changes, this page will be updated and the date at the
				top will change with it.
			</p>

			<h2>Questions</h2>
			<p>
				Anything at all about this, write to
				<a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>.
			</p>

			<p class="back"><a href="/">← Back to the portfolio</a></p>
		</main>

		<Footer />
	</div>
</Layout>

<style>
	.page {
		max-width: 1440px;
		margin: 0 auto;
		background: var(--bg);
	}

	.doc {
		max-width: 68ch;
		margin: 0 auto;
		padding: clamp(48px, 8vw, 88px) clamp(20px, 5vw, 40px) clamp(48px, 7vw, 72px);
	}

	.eyebrow {
		margin: 0;
	}

	h1 {
		margin: 20px 0 0;
		font-family: var(--font-display);
		font-weight: 400;
		font-size: clamp(40px, 6vw, 72px);
		line-height: 1;
		letter-spacing: -0.01em;
	}

	.updated {
		margin: 16px 0 0;
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted);
		border-bottom: 1px solid var(--ink);
		padding-bottom: 20px;
	}

	.lede {
		margin: 32px 0 0;
		font-family: var(--font-display);
		font-size: clamp(19px, 2.2vw, 25px);
		line-height: 1.45;
		text-wrap: pretty;
	}

	h2 {
		margin: clamp(36px, 5vw, 52px) 0 0;
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--accent);
	}

	p,
	li {
		font-size: 17px;
		line-height: 1.65;
		color: #35302b;
		text-wrap: pretty;
	}

	h2 + p {
		margin-top: 14px;
	}

	ul {
		margin: 14px 0 0;
		padding-left: 20px;
	}

	li {
		margin-bottom: 12px;
	}

	strong {
		color: var(--ink);
		font-weight: 600;
	}

	a {
		color: var(--accent);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.back {
		margin-top: clamp(44px, 6vw, 64px);
		border-top: 1px solid var(--line);
		padding-top: 24px;
		font-family: var(--font-mono);
		font-size: 12px;
		letter-spacing: 0.06em;
	}

	.back a {
		color: var(--muted);
		text-decoration: none;
	}

	.back a:hover {
		color: var(--accent);
	}
</style>
